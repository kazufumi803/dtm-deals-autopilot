---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const deals = await getCollection('deals');
  return deals.map((deal) => ({
    params: { slug: deal.slug },
    props: { deal },
  }));
}

interface Props {
  deal: CollectionEntry<'deals'>;
}

const { deal } = Astro.props;
const { Content } = await deal.render();
const isFree = deal.data.category === 'Free';

const plainSummary = deal.body
  .replace(/^#+\s+.*$/gm, '')
  .replace(/\*\*([^*]+)\*\*/g, '$1')
  .replace(/\*([^*]+)\*/g, '$1')
  .replace(/`([^`]+)`/g, '$1')
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  .replace(/^[-\s*]+/gm, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);

const formattedDate = deal.data.pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={deal.data.title}
  description={plainSummary || deal.data.title}
  ogType="article"
  publishedTime={deal.data.pubDate.toISOString()}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-xs font-mono text-slate-400 flex items-center gap-2">
      <a href="/" class="hover:text-teal-300 transition">&larr; セール・無料配布一覧へ戻る</a>
      <span>/</span>
      <span class="text-slate-500 truncate">{deal.slug}</span>
    </nav>

    <!-- Article Header Card -->
    <header class="rounded-3xl bg-studio-900/90 border border-slate-800 p-6 sm:p-10 shadow-2xl relative overflow-hidden">
      <div
        class:list={[
          'absolute inset-x-0 top-0 h-1.5',
          isFree
            ? 'bg-gradient-to-r from-emerald-400 via-teal-400 to-cyan-400'
            : 'bg-gradient-to-r from-amber-400 via-orange-500 to-purple-500',
        ]}
      />

      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span
          class:list={[
            'inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-extrabold tracking-wide uppercase',
            isFree
              ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-400/40'
              : 'bg-amber-500/15 text-amber-300 border border-amber-400/40',
          ]}
        >
          {isFree ? '🎁 FREEBIE / 期間限定無料' : '🔥 SPECIAL SALE / セール情報'}
        </span>

        <time
          datetime={deal.data.pubDate.toISOString()}
          class="font-mono text-xs text-slate-400"
        >
          公開日: {formattedDate}
        </time>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight tracking-tight">
        {deal.data.title}
      </h1>

      <!-- Top Prominent CTA Button -->
      <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <p class="text-xs text-slate-400">
          ※セール価格や無料配布期間は予告なく終了する場合があります。お早めに公式ページでご確認ください。
        </p>
        <a
          href={deal.data.affiliateUrl}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-extrabold text-sm text-slate-950 bg-gradient-to-r from-teal-300 via-teal-400 to-cyan-400 hover:from-teal-200 hover:to-cyan-300 shadow-lg shadow-teal-500/25 hover:shadow-teal-400/40 transition-all shrink-0"
        >
          <span>セールページへ移動する（外部サイト）</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
    </header>

    <!-- Markdown Content Body -->
    <div class="mt-10 rounded-3xl bg-studio-900/60 border border-slate-800/80 p-6 sm:p-10">
      <div
        class="prose prose-invert prose-slate max-w-none
          prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white
          prose-h2:text-xl sm:prose-h2:text-2xl prose-h2:border-l-4 prose-h2:border-teal-400 prose-h2:pl-4 prose-h2:py-1 prose-h2:bg-slate-900/70 prose-h2:rounded-r-lg
          prose-p:text-slate-300 prose-p:leading-relaxed
          prose-li:text-slate-300
          prose-strong:text-teal-300
          prose-a:text-teal-400 hover:prose-a:text-teal-300"
      >
        <Content />
      </div>

      <!-- Bottom Prominent CTA Box -->
      <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-studio-800 via-studio-900 to-purple-950/40 border border-teal-400/40 text-center shadow-2xl shadow-teal-500/10">
        <span class="font-mono text-xs uppercase tracking-widest text-teal-300 block mb-2">
          OFFICIAL STORE / DOWNLOAD LINK
        </span>
        <h3 class="text-xl sm:text-2xl font-extrabold text-white mb-3">
          このプラグインの最新価格・ダウンロードはこちら
        </h3>
        <p class="text-sm text-slate-300 max-w-xl mx-auto mb-6">
          以下のボタンから配布元・ストアページへ直接アクセスできます。クーポンコードや終了日時の詳細もリンク先にてご確認ください。
        </p>

        <a
          href={deal.data.affiliateUrl}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-black text-base sm:text-lg text-slate-950 bg-gradient-to-r from-teal-300 via-emerald-400 to-cyan-400 hover:from-teal-200 hover:to-cyan-300 shadow-xl shadow-teal-500/30 hover:shadow-teal-400/50 hover:-translate-y-0.5 transition-all"
        >
          <span>セールページへ移動する（外部サイト）</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>

      <!-- Amazon DTM Gear Affiliate Box -->
      <div class="mt-8 p-6 sm:p-8 rounded-2xl bg-studio-950/80 border border-amber-500/30">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30">
            AMAZON.CO.JP STUDIO GEAR
          </span>
          <span class="text-xs text-slate-400">DTM制作環境アップグレード</span>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-white mb-4">
          あわせてチェックしたい定番DTM機材・ソフト音源（Amazon）
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <a
            href="https://www.amazon.co.jp/s?k=%E3%82%AA%E3%83%BC%E3%83%87%E3%82%A3%E3%82%AA%E3%82%A4%E3%83%B3%E3%82%BF%E3%83%BC%E3%83%95%E3%82%A7%E3%83%BC%E3%82%B9+DTM&tag=dtmdeals803-22"
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="flex items-center justify-between px-4 py-3 rounded-xl bg-studio-900 border border-slate-800 hover:border-amber-400/60 text-slate-200 hover:text-amber-300 transition"
          >
            <span>🎛️ 人気オーディオインターフェース</span>
            <span class="font-mono text-xs text-amber-400">&rarr;</span>
          </a>
          <a
            href="https://www.amazon.co.jp/s?k=%E3%83%A2%E3%83%8B%E3%82%BF%E3%83%BC%E3%83%98%E3%83%83%E3%83%89%E3%83%9B%E3%83%B3+DTM&tag=dtmdeals803-22"
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="flex items-center justify-between px-4 py-3 rounded-xl bg-studio-900 border border-slate-800 hover:border-amber-400/60 text-slate-200 hover:text-amber-300 transition"
          >
            <span>🎧 定番モニターヘッドホン・スピーカー</span>
            <span class="font-mono text-xs text-amber-400">&rarr;</span>
          </a>
          <a
            href="https://www.amazon.co.jp/s?k=MIDI%E3%82%AD%E3%83%BC%E3%83%9C%E3%83%BC%E3%83%89+DTM&tag=dtmdeals803-22"
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="flex items-center justify-between px-4 py-3 rounded-xl bg-studio-900 border border-slate-800 hover:border-amber-400/60 text-slate-200 hover:text-amber-300 transition"
          >
            <span>🎹 MIDIキーボード・コントローラー</span>
            <span class="font-mono text-xs text-amber-400">&rarr;</span>
          </a>
          <a
            href="https://www.amazon.co.jp/s?k=DTM+%E3%82%BD%E3%83%95%E3%83%88%E9%9F%B3%E6%BA%90+%E3%83%97%E3%83%A9%E3%82%B0%E3%82%A4%E3%83%B3&tag=dtmdeals803-22"
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="flex items-center justify-between px-4 py-3 rounded-xl bg-studio-900 border border-slate-800 hover:border-amber-400/60 text-slate-200 hover:text-amber-300 transition"
          >
            <span>💿 DTMソフト音源・プラグインセール</span>
            <span class="font-mono text-xs text-amber-400">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
