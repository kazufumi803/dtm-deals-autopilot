# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Affiliate Tags (Optional: 未設定時は元のURLがそのまま使用されます)
AFFILIATE_TAG_PB=your_plugin_boutique_affiliate_id
AFFILIATE_TAG_AMAZON=your_amazon_associate_tag-22

# Site Public Base URL (末尾スラッシュなし)
SITE_URL=https://your-domain.example.com

# X (Twitter) API v2 Credentials
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
